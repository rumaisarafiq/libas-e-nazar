rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    match /orders/{orderId} {
      allow create: if true; 
      allow read, update, delete: if false;
    }

    match /authHistory/{eventId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }
  }
}